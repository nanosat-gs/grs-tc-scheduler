# TC Scheduler — variáveis que este serviço lê rodando sozinho.
#
# Em produção quem manda é o .env do orquestrador (nanosat-gs/grs-station).
# Este arquivo documenta só o que ESTE repo precisa para subir isolado.

# --- Banco ---
# O mesmo banco do TC Generator: é ele quem cria o schema. Este serviço é o
# único que ESCREVE nele. Ver docs/schema-contract.md.
PG_DATABASE_URL=postgresql+psycopg2://admin:admin@localhost:5432/tc_generator

# --- Station Manager ---
# Para onde vão as ordens de rastreamento (uma por passagem, não um setpoint
# por segundo).
STATION_MANAGER_ZMQ_ADDRESS=tcp://localhost:5580
ZMQ_REQUEST_TIMEOUT_MS=3000

# --- API de leitura ---
# É daqui que o painel do GRS Manager se serve, no lugar de abrir o banco.
SCHEDULER_API_HOST=0.0.0.0
SCHEDULER_API_PORT=5591
SCHEDULER_API_ENABLED=1

# --- Ritmo do laço ---
SCHEDULER_TICK_SECONDS=1
SCHEDULER_HORIZON_HOURS=24
SCHEDULER_REPLAN_INTERVAL_SECONDS=300
TRACKING_POLL_INTERVAL_SECONDS=30

# Passagens curtas ou rasantes custam mais em movimentação de antena do que
# rendem em tempo de link útil. Um cliente com máscara em 0 graus vai listar
# passagens que a estação decidiu não rastrear — é diferença de política, não
# de cálculo.
SCHEDULER_MIN_PASS_DURATION_SECONDS=60
SCHEDULER_MIN_PASS_ELEVATION_DEG=5

# --- Estação terrestre ---
# Lidas pela spacelab-tracking. O valor abaixo é um EXEMPLO (São Paulo) e
# precisa ser trocado antes de qualquer uso real. Precisam bater com as do
# Station Manager, ou o plano e o apontamento divergem.
GS_NAME=Estação de Teste
GS_LATITUDE_DEG=-23.5505
GS_LONGITUDE_DEG=-46.6333
GS_ALTITUDE_M=760
GS_MIN_ELEVATION_DEG=0

# --- Cache de TLE ---
# Este serviço é o único que escreve e lê esse cache. O botão "Atualizar TLE"
# do painel chega aqui como um POST /api/tle/refresh.
TRACKING_DATA_DIR=./data
TRACKING_CACHE_MAX_AGE_MINUTES=15
